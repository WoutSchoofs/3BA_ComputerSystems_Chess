# =============================================================================
# Project makefile
# =============================================================================

# Build both programs by default.
all: zetten_logica.exe DRAW_BOARD.exe

# =============================================================================
# Do NOT edit this section, unless you know what you are doing.
# =============================================================================
.asm.obj:
  # use TASM with debug info (stripped anyway by wlink if not used)
  tasm /ml /m2 /w2 /z /zi $<

zetten_logica.exe: zetten_logica.obj
  wlink option quiet system pmodew name zetten_logica.exe file {zetten_logica.obj}

DRAW_BOARD.exe: DRAW_BOARD.obj
  wlink option quiet system pmodew name DRAW_BOARD.exe file {DRAW_BOARD.obj}

clean: .symbolic
  del *.obj
  del zetten_logica.exe DRAW_BOARD.exe

debug: debug_zetten

debug_zetten: zetten_logica.obj .symbolic
  wlink debug watcom all option quiet system pmodew name zetten_logica.exe file {zetten_logica.obj}
  wd /tr=rsi /li=43 zetten_logica.exe

debug_board: DRAW_BOARD.obj .symbolic
  wlink debug watcom all option quiet system pmodew name DRAW_BOARD.exe file {DRAW_BOARD.obj}
  wd /tr=rsi /li=43 DRAW_BOARD.exe
